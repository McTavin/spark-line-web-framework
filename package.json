{
  "name": "@spark-line/web-framework",
  "version": "0.1.0",
  "description": "Structural UI contracts and accessible primitives for Astro, optional React islands, and optional Sanity section data.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "./styles/*.css"
  ],
  "files": [
    "dist/",
    "src/astro/",
    "styles/",
    "starter/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./astro": {
      "types": "./src/astro/index.d.ts",
      "import": "./dist/astro/index.js",
      "default": "./dist/astro/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./sanity": {
      "types": "./dist/sanity/index.d.ts",
      "import": "./dist/sanity/index.js",
      "default": "./dist/sanity/index.js"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "import": "./dist/registry/index.js",
      "default": "./dist/registry/index.js"
    },
    "./styles/foundation.css": "./styles/foundation.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/build.mjs",
    "check": "tsc -p tsconfig.build.json --noEmit && node scripts/validate-package.mjs",
    "clean": "node scripts/clean.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "pack:artifact": "node scripts/create-pack.mjs",
    "test:fixtures": "node scripts/test-packed-fixtures.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "pack:inspect": "node scripts/inspect-pack.mjs",
    "prepack": "npm run build && npm run check && npm test"
  },
  "peerDependencies": {
    "astro": ">=5 <8",
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "sanity": ">=3 <5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "sanity": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.54.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "astro": "^7.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/McTavin/spark-line-web-framework.git"
  },
  "bugs": {
    "url": "https://github.com/McTavin/spark-line-web-framework/issues"
  },
  "homepage": "https://github.com/McTavin/spark-line-web-framework#readme"
}
