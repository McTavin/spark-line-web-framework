---
import "@spark-line/web-framework/styles/foundation.css";
import "../styles/project.css";
import {
  Heading,
  PageFlow,
  Section,
  Stack,
  Text
} from "@spark-line/web-framework/astro";
import CounterFixture from "../components/CounterFixture";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>React island fixture</title>
  </head>
  <body>
    <PageFlow>
      <Section>
        <Stack gap="lg">
          <Heading level={1}>Project-owned React island</Heading>
          <Text>Astro owns this section and its spacing.</Text>
          <CounterFixture client:load initialCount={0} />
        </Stack>
      </Section>
    </PageFlow>
  </body>
</html>
