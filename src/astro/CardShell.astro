---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"article"> {
  as?: "article" | "div" | "li";
  surface?: "default" | "quiet" | "accent";
}

const {
  as: Tag = "article",
  surface = "default",
  class: className,
  ...attributes
} = Astro.props;
---

<Tag class:list={["slf-card-shell", className]} data-surface={surface} {...attributes}>
  <slot />
</Tag>
